# Dependency directories
node_modules/

# Build outputs
/dist
/build

# Environment files
.env
.env.*

# Logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
logs/
*.log

# OS files
.DS_Store
Thumbs.db

# Editor directories
.vscode/
.idea/

# Coverage
coverage/
.nyc_output/

# Misc caches
.cache/
.parcel-cache/
/.vite

# Mac/Windows filesystem files
.Spotlight-V100
.Trashes

# Static archive files
*.tgz

# Optional: local lock files (uncomment if you don't commit lockfiles)
# package-lock.json
# yarn.lock

# Ignore server/client specific build folders if they exist
/client/dist
/client/build
/server/dist
/server/build

# Keep dotenv example files
!*.env.example
